{
  "name": "save_project_copy",
  "verified": false,
  "verified_note": "Draft. Not yet confirmed on a real FL Studio install; calibrate at Gate 0.",
  "summary": "Save the open project under a new path with Save As.",
  "params": [
    "path"
  ],
  "vision": false,
  "source": "https://www.image-line.com/fl-studio-learning/fl-studio-online-manual/html/basics_shortcuts.htm (Save As: Ctrl+Shift+S)",
  "steps": [
    {
      "do": "hotkey",
      "keys": [
        "ctrl",
        "shift",
        "s"
      ]
    },
    {
      "do": "expect_dialog",
      "contains": "Save",
      "timeout_s": 5
    },
    {
      "do": "type",
      "text": "{path}"
    },
    {
      "do": "hotkey",
      "keys": [
        "enter"
      ]
    },
    {
      "do": "expect_no_dialog",
      "timeout_s": 20
    },
    {
      "do": "expect_file",
      "path": "{path}",
      "timeout_s": 15
    }
  ]
}
